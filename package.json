{
  "name": "veckly-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "dev:serve": "node --env-file=.env --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:local": "DATABASE_URL=postgres://postgres:postgres@localhost:54333/postgres TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54333/postgres_test SUPABASE_URL=http://localhost:54321 SUPABASE_ANON_KEY=test vitest run",
    "openapi:write": "node --import tsx/esm scripts/write-openapi.ts ../Veckly-ios/OpenAPI/veckly-openapi.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^0.18.4",
    "@supabase/supabase-js": "^2.49.0",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
