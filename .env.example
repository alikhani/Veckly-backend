# Supabase Postgres connection string (Settings > Database > Connection string > URI)
# Use the "transaction" pooler (port 6543) for serverless/Vercel deployments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Supabase project settings (Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Postgres connection used only by the RLS test suite — must point at a real
# Postgres instance (local or a disposable Supabase branch), never production.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres_test
