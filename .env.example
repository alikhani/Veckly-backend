# Supabase Postgres connection string (Settings > Database > Connection string > URI)
# Use the "transaction" pooler (port 6543) for serverless/Vercel deployments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Supabase project settings (Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Postgres connection used only by the RLS test suite — must point at a real
# Postgres instance (local or a disposable Supabase branch), never production.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres_test

# Shared secret for server-to-server calls from MealPlanner during the strangle
# phase. Must match VECKLY_INTERNAL_API_KEY in MealPlanner's env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set to empty / unset to disable the /internal/* routes entirely.
VECKLY_INTERNAL_API_KEY=
# Server-only kill switch. Phase 1 persists/resolves entitlements but does not
# enforce any premium limits until a later, explicitly enabled rollout.
PREMIUM_GATES_ENABLED=false

# Phase 3B App Store integration is sandbox-only. These values enable JWS
# verification for TestFlight/sandbox transactions and notifications; they do
# not enable paywalls or premium gates. Keep production App Store credentials
# out of this slice.
# Comma-separated DER certificates, each base64-encoded. Download Apple's root
# certificates from https://www.apple.com/certificateauthority/.
APP_STORE_ROOT_CA_CERTIFICATES_BASE64=
# Online certificate status checks are enabled unless explicitly set to false.
APP_STORE_ENABLE_ONLINE_CHECKS=true
# In-App Purchase key from App Store Connect > Users and Access > Integrations.
# The .p8 file is supplied as base64 so multiline secrets survive Vercel env.
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY_BASE64=
